/*
  # Enforce HTTPS and prevent SSL stripping
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Block clickjacking framing attacks
  X-Frame-Options: DENY

  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Control cross-origin referrer leakage
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable risky browser features
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

  # Restrict resource loading locations (XSS mitigation)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:; connect-src 'self'; frame-ancestors 'none';